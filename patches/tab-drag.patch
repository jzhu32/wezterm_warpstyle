+    /// Return the stable tab snapshot translated under the live pointer.
+    fn dragged_tab_preview(&self, computed: &ComputedElement) -> Option<(usize, ComputedElement)> {
+        let (drag_item, drag_event) = self.dragging.as_ref()?;
+        let tab_idx = match &drag_item.item_type {
+            UIItemType::TabBar(TabBarItem::Tab { tab_idx, .. }) => *tab_idx,
+            _ => return None,
+        };
+        let offset = self.dragging_tab_start_offset?;
+        let snapshot = self.dragging_tab_snapshot.as_ref()?;
+        let start_x = drag_item.x as isize + offset;
+        if !tab_drag_has_started(start_x, drag_event.coords.x) {
+            return None;
+        }
+
+        let target_x = dragged_tab_left(
+            drag_event.coords.x,
+            offset,
+            snapshot.bounds.width() as isize,
+            computed.bounds.min_x() as isize,
+            computed.bounds.max_x() as isize,
+        ) as f32;
+        let mut floating = snapshot.clone();
+        let delta_x = target_x - floating.bounds.min_x();
+        floating.translate(euclid::Vector2D::new(delta_x, 0.0));
+        floating.zindex = i8::MAX;
+        Some((tab_idx, floating))
+    }
+}
+
+/// Capture the complete painted tab once, before live reordering can change
+/// its index or title. The snapshot remains readable beneath the pointer for
+/// the entire drag.
+pub(in crate::termwindow) fn clone_tab_element(
+    computed: &ComputedElement,
+    target_tab_idx: usize,
+) -> Option<ComputedElement> {
+    if matches!(
+        &computed.item_type,
+        Some(UIItemType::TabBar(TabBarItem::Tab { tab_idx, .. })) if *tab_idx == target_tab_idx
+    ) {
+        return Some(computed.clone());
+    }
+    if let ComputedElementContent::Children(kids) = &computed.content {
+        for kid in kids {
+            if let Some(found) = clone_tab_element(kid, target_tab_idx) {
+                return Some(found);
+            }
+        }
+    }
+    None
+}
+
+/// Remove the live copy of the dragged tab from a cloned, already-computed bar.
+/// Its laid-out space remains as a clean insertion gap while the stable snapshot
+/// is painted above the neighboring tabs.
+fn remove_tab_element(computed: &mut ComputedElement, target_tab_idx: usize) -> bool {
+    if let ComputedElementContent::Children(kids) = &mut computed.content {
+        if let Some(index) = kids.iter().position(|kid| {
+            matches!(
+                &kid.item_type,
+                Some(UIItemType::TabBar(TabBarItem::Tab { tab_idx, .. })) if *tab_idx == target_tab_idx
+            )
+        }) {
+            kids.remove(index);
+            return true;
+        }
+        for kid in kids {
+            if remove_tab_element(kid, target_tab_idx) {
+                return true;
+            }
+        }
+    }
+    false
 }
 

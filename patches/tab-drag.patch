new file mode 100644
index 0000000..5f22e8c
--- /dev/null
+++ b/wezterm-gui/src/termwindow/tab_drag.rs
@@ -0,0 +1,54 @@
+/// Cross neighboring tab midpoints, including several in a single fast move.
+pub(crate) fn tab_drag_target(
+    current: usize,
+    pointer_x: isize,
+    bounds: impl IntoIterator<Item = (usize, usize, usize)>,
+) -> usize {
+    let mut target = current;
+    for (index, left, width) in bounds {
+        let midpoint = left.saturating_add(width / 2) as isize;
+        if index < current && pointer_x < midpoint {
+            target = target.min(index);
+        } else if index > current && pointer_x > midpoint {
+            target = target.max(index);
+        }
+    }
+    target
+}
+
+#[cfg(test)]
+mod tests {
+    use super::tab_drag_target;
+
+    const TABS: [(usize, usize, usize); 4] =
+        [(0, 100, 100), (1, 200, 100), (2, 300, 100), (3, 400, 100)];
+
+    #[test]
+    fn crosses_midpoints_in_both_directions() {
+        assert_eq!(tab_drag_target(1, 220, TABS), 1);
+        assert_eq!(tab_drag_target(1, 350, TABS), 1);
+        assert_eq!(tab_drag_target(1, 351, TABS), 2);
+        assert_eq!(tab_drag_target(2, 250, TABS), 2);
+        assert_eq!(tab_drag_target(2, 249, TABS), 1);
+    }
+
+    #[test]
+    fn handles_fast_moves_and_clamps_at_the_ends() {
+        assert_eq!(tab_drag_target(0, 900, TABS), 3);
+        assert_eq!(tab_drag_target(3, -50, TABS), 0);
+        assert_eq!(tab_drag_target(0, -50, TABS), 0);
+        assert_eq!(tab_drag_target(3, 900, TABS), 3);
+        assert_eq!(tab_drag_target(0, 300, [(0, 100, 100)]), 0);
+        assert_eq!(tab_drag_target(0, 300, []), 0);
+    }
+
+    #[test]
+    fn uses_actual_widths_and_supports_reversing_a_drag() {
+        let tabs = [(0, 100, 80), (1, 180, 220), (2, 400, 100)];
+        assert_eq!(tab_drag_target(0, 289, tabs), 0);
+        assert_eq!(tab_drag_target(0, 291, tabs), 1);
+        assert_eq!(tab_drag_target(2, 139, tabs), 0);
+        assert_eq!(tab_drag_target(3, 220, TABS), 1);
+        assert_eq!(tab_drag_target(1, 451, TABS), 3);
+    }
+}

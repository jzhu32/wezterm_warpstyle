+use mux::window::WindowId;
+use std::cell::RefCell;
+use wezterm_term::Line;
+
+const DRAG_THRESHOLD: isize = 4;
+pub(crate) const CROSS_WINDOW_DRAG_PREVIEW_TAB_IDX: usize = usize::MAX;
+
+#[derive(Clone)]
+pub(crate) struct CrossWindowTabDrag {
+    pub(crate) source_window_id: WindowId,
+    pub(crate) destination_window_id: WindowId,
+    pub(crate) title: Line,
+}
+
+thread_local! {
+    static CROSS_WINDOW_TAB_DRAG: RefCell<Option<CrossWindowTabDrag>> = const {
+        RefCell::new(None)
+    };
+}
+
+pub(crate) fn cross_window_tab_drag_for(
+    destination_window_id: WindowId,
+) -> Option<CrossWindowTabDrag> {
+    CROSS_WINDOW_TAB_DRAG.with(|drag| {
+        drag.borrow()
+            .as_ref()
+            .filter(|drag| drag.destination_window_id == destination_window_id)
+            .cloned()
+    })
+}
+
+pub(crate) fn has_cross_window_tab_drag_from(source_window_id: WindowId) -> bool {
+    CROSS_WINDOW_TAB_DRAG.with(|drag| {
+        drag.borrow()
+            .as_ref()
+            .is_some_and(|drag| drag.source_window_id == source_window_id)
+    })
+}
+
+pub(crate) fn set_cross_window_tab_drag(
+    source_window_id: WindowId,
+    destination: Option<(WindowId, Line)>,
+) -> (Option<WindowId>, Option<WindowId>) {
+    CROSS_WINDOW_TAB_DRAG.with(|drag| {
+        let mut drag = drag.borrow_mut();
+        let previous = drag
+            .as_ref()
+            .filter(|drag| drag.source_window_id == source_window_id)
+            .map(|drag| drag.destination_window_id);
+        let next = destination.as_ref().map(|(window_id, _)| *window_id);
+
+        if previous != next {
+            *drag = destination.map(|(destination_window_id, title)| CrossWindowTabDrag {
+                source_window_id,
+                destination_window_id,
+                title,
+            });
+        }
+
+        (previous, next)
+    })
+}
+
+/// Ignore tiny pointer jitter so an ordinary click remains visually still.
+pub(crate) fn tab_drag_has_started(
+    start: (isize, isize),
+    pointer: (isize, isize),
+    already_dragging: bool,
+) -> bool {
+    already_dragging
+        || pointer.0.abs_diff(start.0) >= DRAG_THRESHOLD as usize
+        || pointer.1.abs_diff(start.1) >= DRAG_THRESHOLD as usize
+}
+
+/// Require a deliberate vertical pull beyond the strip before creating a window.
+pub(crate) fn tab_drag_should_detach(pointer_y: isize, tab_top: isize, tab_height: isize) -> bool {
+    let margin = (tab_height / 2).max(8);
+    pointer_y < tab_top.saturating_sub(margin)
+        || pointer_y > tab_top.saturating_add(tab_height).saturating_add(margin)
+}
+
+/// Whether a screen-coordinate pointer is over a visible window. A whole-window
+/// target is intentionally generous: once a tab has left its source window,
+/// any part of another WezTerm window acts as a magnetic join target.
+pub(crate) fn screen_point_is_in_window(
+    point: (isize, isize),
+    window: (isize, isize, isize, isize),
+) -> bool {
+    let (x, y, width, height) = window;
+    if width <= 0 || height <= 0 {
+        return false;
+    }
+    point.0 >= x
+        && point.0 < x.saturating_add(width)
+        && point.1 >= y
+        && point.1 < y.saturating_add(height)
+}
+
+/// Keep the floating tab inside the tab bar while retaining the grab offset.
+pub(crate) fn dragged_tab_left(
+    pointer_x: isize,
+    grab_offset: isize,
+    tab_width: isize,
+    bar_left: isize,
+    bar_right: isize,
+) -> isize {
+    let rightmost = bar_right.saturating_sub(tab_width).max(bar_left);
+    pointer_x
+        .saturating_sub(grab_offset)
+        .clamp(bar_left, rightmost)
+}
+
+/// Switch to the native floating preview as soon as any edge of the tab
+/// leaves the source window. Waiting for the pointer itself to leave would
+/// clamp the in-window preview first and make it jump by the grab offset at
+/// the handoff.
+pub(crate) fn tab_drag_preview_needs_native(
+    pointer: (isize, isize),
+    grab_offset: (isize, isize),
+    tab_size: (isize, isize),
+    window_size: (isize, isize),
+) -> bool {
+    let left = pointer.0.saturating_sub(grab_offset.0);
+    let top = pointer.1.saturating_sub(grab_offset.1);
+    let right = left.saturating_add(tab_size.0.max(0));
+    let bottom = top.saturating_add(tab_size.1.max(0));
+
+    left < 0 || top < 0 || right > window_size.0.max(0) || bottom > window_size.1.max(0)
+}
+
+/// Cross neighboring tab midpoints using the dragged tab's center, including
+/// several in a single fast move.
+pub(crate) fn tab_drag_target(
+    current: usize,
+    dragged_center_x: isize,
+    bounds: impl IntoIterator<Item = (usize, usize, usize)>,
+) -> usize {
+    let mut target = current;
+    for (index, left, width) in bounds {
+        let midpoint = left.saturating_add(width / 2) as isize;
+        if index < current && dragged_center_x < midpoint {
+            target = target.min(index);
+        } else if index > current && dragged_center_x > midpoint {
+            target = target.max(index);
+        }
+    }
+    target
+}

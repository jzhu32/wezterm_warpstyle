+            _ => None,
+        }).min().unwrap_or(computed.bounds.min_x() as isize);
+        let target_x = dragged_tab_left(
+            drag_event.coords.x,
+            offset,
+            snapshot.bounds.width() as isize,
+            tabs_left,
+            computed.bounds.max_x() as isize,
+        ) as f32;
+        Some((tab_idx, tab_drag_preview(snapshot, target_x)))
+    }
+}
+
+fn tab_drag_preview(snapshot: &ComputedElement, target_x: f32) -> ComputedElement {
+    let mut floating = snapshot.clone();
+    let delta_x = target_x - floating.bounds.min_x();
+    floating.translate(euclid::Vector2D::new(delta_x, 0.0));
+    floating
+}

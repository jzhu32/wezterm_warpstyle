new file mode 100644
index 0000000..8233bac
--- /dev/null
+++ b/wezterm-gui/src/termwindow/tab_drag.rs
@@ -0,0 +1,98 @@
+const DRAG_THRESHOLD: isize = 4;
+
+/// Ignore tiny pointer jitter so an ordinary click remains visually still.
+pub(crate) fn tab_drag_has_started(start_x: isize, pointer_x: isize, already_dragging: bool) -> bool {
+    already_dragging || pointer_x.abs_diff(start_x) >= DRAG_THRESHOLD as usize
+}
+
+/// Keep the floating tab inside the tab bar while retaining the grab offset.
+pub(crate) fn dragged_tab_left(
+    pointer_x: isize,
+    grab_offset: isize,
+    tab_width: isize,
+    bar_left: isize,
+    bar_right: isize,
+) -> isize {
+    let rightmost = bar_right.saturating_sub(tab_width).max(bar_left);
+    pointer_x
+        .saturating_sub(grab_offset)
+        .clamp(bar_left, rightmost)
+}
+
+/// Cross neighboring tab midpoints using the dragged tab's center, including
+/// several in a single fast move.
+pub(crate) fn tab_drag_target(
+    current: usize,
+    dragged_center_x: isize,
+    bounds: impl IntoIterator<Item = (usize, usize, usize)>,
+) -> usize {
+    let mut target = current;
+    for (index, left, width) in bounds {
+        let midpoint = left.saturating_add(width / 2) as isize;
+        if index < current && dragged_center_x < midpoint {
+            target = target.min(index);
+        } else if index > current && dragged_center_x > midpoint {
+            target = target.max(index);
+        }
+    }
+    target
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{dragged_tab_left, tab_drag_has_started, tab_drag_target};
+
+    const TABS: [(usize, usize, usize); 4] =
+        [(0, 100, 100), (1, 200, 100), (2, 300, 100), (3, 400, 100)];
+
+    #[test]
+    fn crosses_midpoints_in_both_directions() {
+        assert_eq!(tab_drag_target(1, 220, TABS), 1);
+        assert_eq!(tab_drag_target(1, 350, TABS), 1);
+        assert_eq!(tab_drag_target(1, 351, TABS), 2);
+        assert_eq!(tab_drag_target(2, 250, TABS), 2);
+        assert_eq!(tab_drag_target(2, 249, TABS), 1);
+    }
+
+    #[test]
+    fn handles_fast_moves_and_clamps_at_the_ends() {
+        assert_eq!(tab_drag_target(0, 900, TABS), 3);
+        assert_eq!(tab_drag_target(3, -50, TABS), 0);
+        assert_eq!(tab_drag_target(0, -50, TABS), 0);
+        assert_eq!(tab_drag_target(3, 900, TABS), 3);
+        assert_eq!(tab_drag_target(0, 300, [(0, 100, 100)]), 0);
+        assert_eq!(tab_drag_target(0, 300, []), 0);
+    }
+
+    #[test]
+    fn uses_actual_widths_and_supports_reversing_a_drag() {
+        let tabs = [(0, 100, 80), (1, 180, 220), (2, 400, 100)];
+        assert_eq!(tab_drag_target(0, 289, tabs), 0);
+        assert_eq!(tab_drag_target(0, 291, tabs), 1);
+        assert_eq!(tab_drag_target(2, 139, tabs), 0);
+        assert_eq!(tab_drag_target(3, 220, TABS), 1);
+        assert_eq!(tab_drag_target(1, 451, TABS), 3);
+    }
+
+    #[test]
+    fn starts_after_a_small_deliberate_move() {
+        assert!(!tab_drag_has_started(200, 203, false));
+        assert!(tab_drag_has_started(200, 204, false));
+        assert!(tab_drag_has_started(200, 196, false));
+    }
+
+    #[test]
+    fn stays_active_when_the_pointer_returns_to_the_grab_point() {
+        assert!(tab_drag_has_started(200, 200, true));
+        assert!(tab_drag_has_started(200, 203, true));
+        assert!(!tab_drag_has_started(200, 200, false));
+    }
+
+    #[test]
+    fn keeps_the_grab_point_and_clamps_the_preview_to_the_bar() {
+        assert_eq!(dragged_tab_left(250, 25, 100, 70, 500), 225);
+        assert_eq!(dragged_tab_left(20, 25, 100, 70, 500), 70);
+        assert_eq!(dragged_tab_left(600, 25, 100, 70, 500), 400);
+        assert_eq!(dragged_tab_left(250, 25, 500, 70, 500), 70);
+    }
+}

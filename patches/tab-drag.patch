+        assert!(!screen_point_is_in_window((100, 700), window));
+        assert!(!screen_point_is_in_window((0, 0), (0, 0, 0, 0)));
+    }
+
+    #[test]
+    fn tracks_and_clears_the_destination_preview_by_source_window() {
+        let title = Line::from_text("Codex", &CellAttributes::default(), SEQ_ZERO, None);
+        assert_eq!(
+            set_cross_window_tab_drag(7, Some((9, title))),
+            (None, Some(9))
+        );
+        let preview = cross_window_tab_drag_for(9).unwrap();
+        assert_eq!(preview.source_window_id, 7);
+        assert_eq!(preview.title.as_str(), "Codex");
+        assert!(has_cross_window_tab_drag_from(7));
+
+        assert_eq!(set_cross_window_tab_drag(8, None), (None, None));
+        assert!(cross_window_tab_drag_for(9).is_some());
+        assert_eq!(set_cross_window_tab_drag(7, None), (Some(9), None));
+        assert!(cross_window_tab_drag_for(9).is_none());
+    }
+}

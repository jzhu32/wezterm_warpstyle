+    /// Find another visible WezTerm window beneath the pointer. The entire
+    /// destination window is a magnetic target, so joining works equally well
+    /// above, below, or beside the source without precisely aiming at a strip.
+    /// The current client rect is excluded so an overlapping window never
+    /// turns an ordinary in-window reorder into a cross-window move.
+    fn tab_drop_target(&self, event: &MouseEvent) -> Option<GuiWin> {
+        if event.coords.x >= 0
+            && event.coords.x < self.dimensions.pixel_width as isize
+            && event.coords.y >= 0
+            && event.coords.y < self.dimensions.pixel_height as isize
+        {
+            return None;
+        }
+
+        super::front_end()
+            .gui_windows()
+            .into_iter()
+            .find(|candidate| {
+                if candidate.mux_window_id == self.mux_window_id {
+                    return false;
+                }
+                let Some(rect) = candidate.window.get_window_rect() else {
+                    return false;
+                };
+                screen_point_is_in_window(
+                    (event.screen_coords.x, event.screen_coords.y),
+                    (rect.min_x(), rect.min_y(), rect.width(), rect.height()),
+                )
+            })
+    }
+
+    fn tab_title(&self, tab_idx: usize) -> Option<Line> {
+        self.tab_bar
+            .items()
+            .iter()
+            .find(|entry| {
+                matches!(entry.item, TabBarItem::Tab { tab_idx: idx, .. } if idx == tab_idx)
+            })
+            .map(|entry| entry.title.clone())
+    }
+
+    fn update_cross_window_tab_drag(&self, destination: Option<&GuiWin>, tab_idx: Option<usize>) {
+        let title = tab_idx.and_then(|tab_idx| self.tab_title(tab_idx));
+        let destination = destination
+            .and_then(|destination| title.map(|title| (destination.mux_window_id, title)));
+        let (previous, next) = set_cross_window_tab_drag(self.mux_window_id, destination);
+
+        if previous == next {
+            return;
+        }
+
+        for window_id in [previous, next].iter().flatten() {
+            if let Some(gui_window) = super::front_end()
+                .gui_windows()
+                .into_iter()
+                .find(|window| window.mux_window_id == *window_id)
+            {
+                gui_window
+                    .window
+                    .notify(TermWindowNotif::Apply(Box::new(|term_window| {
+                        term_window.invalidate_fancy_tab_bar();
+                        if let Some(window) = &term_window.window {
+                            window.invalidate();
+                        }
+                    })));
+            }
+        }
+    }
+
+    pub(crate) fn clear_cross_window_tab_drag(&self) {
+        self.update_cross_window_tab_drag(None, None);
+    }

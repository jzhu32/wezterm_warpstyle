+    /// Return the stable tab snapshot translated under the live pointer.
+    fn dragged_tab_preview(&self, computed: &ComputedElement) -> Option<(usize, ComputedElement)> {
+        if has_cross_window_tab_drag_from(self.mux_window_id) {
+            return None;
+        }
+        let (drag_item, drag_event) = self.dragging.as_ref()?;
+        let tab_idx = match &drag_item.item_type {
+            UIItemType::TabBar(TabBarItem::Tab { tab_idx, .. }) => *tab_idx,
+            _ => return None,
+        };
+        let (offset, grab_y) = self.dragging_tab_grab_offset?;
+        if tab_drag_preview_needs_native(
+            (drag_event.coords.x, drag_event.coords.y),
+            (offset, grab_y),
+            (drag_item.width as isize, drag_item.height as isize),
+            (
+                self.dimensions.pixel_width as isize,
+                self.dimensions.pixel_height as isize,
+            ),
+        ) {
+            return None;
+        }
+        let snapshot = self.dragging_tab_snapshot.as_ref()?;
+        let tabs_left = self
+            .ui_items
+            .iter()
+            .filter_map(|item| match item.item_type {
+                UIItemType::TabBar(TabBarItem::Tab { .. }) => Some(item.x as isize),
+                _ => None,
+            })
+            .min()
+            .unwrap_or(computed.bounds.min_x() as isize);
+        let target_x = dragged_tab_left(
+            drag_event.coords.x,
+            offset,
+            snapshot.bounds.width() as isize,
+            tabs_left,
+            computed.bounds.max_x() as isize,
+        ) as f32;
+        let target_y = drag_event.coords.y.saturating_sub(grab_y).clamp(
+            0,
+            (self.dimensions.pixel_height as isize - snapshot.bounds.height() as isize).max(0),
+        ) as f32;
+        Some((tab_idx, tab_drag_preview(snapshot, target_x, target_y)))
+    }
+}
+
+fn tab_drag_preview(snapshot: &ComputedElement, target_x: f32, target_y: f32) -> ComputedElement {
+    let mut floating = snapshot.clone();
+    let delta_x = target_x - floating.bounds.min_x();
+    let delta_y = target_y - floating.bounds.min_y();
+    floating.translate(euclid::Vector2D::new(delta_x, delta_y));
+    floating
+}

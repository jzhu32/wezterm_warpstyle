+        assert!(!tab_drag_has_started((200, 20), (200, 20), false));
+    }
+
+    #[test]
+    fn starts_on_vertical_movement_and_requires_deliberate_detachment() {
+        assert!(tab_drag_has_started((200, 20), (200, 24), false));
+        assert!(!tab_drag_should_detach(60, 0, 40));
+        assert!(tab_drag_should_detach(61, 0, 40));
+        assert!(!tab_drag_should_detach(-20, 0, 40));
+        assert!(tab_drag_should_detach(-21, 0, 40));
+        assert!(!tab_drag_should_detach(520, 500, 40));
+        assert!(tab_drag_should_detach(479, 500, 40));
+    }
+
+    #[test]
+    fn keeps_the_grab_point_and_clamps_the_preview_to_the_bar() {
+        assert_eq!(dragged_tab_left(250, 25, 100, 70, 500), 225);
+        assert_eq!(dragged_tab_left(20, 25, 100, 70, 500), 70);
+        assert_eq!(dragged_tab_left(600, 25, 100, 70, 500), 400);
+        assert_eq!(dragged_tab_left(250, 25, 500, 70, 500), 70);
+    }
+
+    #[test]
+    fn hands_off_when_the_tab_edge_crosses_the_window() {
+        let grab = (20, 10);
+        let tab = (100, 40);

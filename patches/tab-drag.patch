+    /// Move the existing tab and its complete pane layout without restarting anything.
+    pub fn move_tab_to_new_window(
+        &self,
+        tab_id: TabId,
+        position: Option<GuiPosition>,
+    ) -> anyhow::Result<WindowId> {
+        let source_id = self
+            .window_containing_tab(tab_id)
+            .ok_or_else(|| anyhow!("tab {tab_id} is not in a window"))?;
+        let workspace = self
+            .get_window(source_id)
+            .ok_or_else(|| anyhow!("source window disappeared"))?
+            .get_workspace()
+            .to_string();
+        let destination = self.new_empty_window(Some(workspace), position);
+        let destination_id = *destination;
+        self.move_tab_to_window(tab_id, destination_id)?;
+        // The builder keeps this new window alive throughout the transfer.
+        drop(destination);
+        // Recheck now that the builder's activity guard no longer keeps an
+        // emptied source window alive.
+        self.prune_dead_windows();
+        Ok(destination_id)
+    }
+
+    /// Move an existing tab, including all of its panes and state, into an
+    /// existing window and make it the active tab there.
+    pub fn move_tab_to_window(
+        &self,
+        tab_id: TabId,
+        destination_id: WindowId,
+    ) -> anyhow::Result<()> {
+        let source_id = self
+            .window_containing_tab(tab_id)
+            .ok_or_else(|| anyhow!("tab {tab_id} is not in a window"))?;
+        if source_id == destination_id {
+            return Err(anyhow!(
+                "tab {tab_id} is already in window {destination_id}"
+            ));
+        }
+        {
+            let mut windows = self.windows.write();
+            if !windows.contains_key(&destination_id) {
+                return Err(anyhow!("destination window {destination_id} disappeared"));
+            }
+            let source = windows
+                .get_mut(&source_id)
+                .ok_or_else(|| anyhow!("source window disappeared"))?;
+            let index = source
+                .get_tab_idx_for_id(tab_id)
+                .ok_or_else(|| anyhow!("tab {tab_id} disappeared"))?;
+            let tab = source.remove_tab_idx(index);
+            let destination = windows.get_mut(&destination_id).unwrap();
+            destination.push_tab(&tab);
+            destination.set_active_tab_idx_without_saving(destination.count_tabs() - 1);
+        }
+        self.recompute_pane_count();
+        self.notify(MuxNotification::TabAddedToWindow {
+            tab_id,
+            window_id: destination_id,
+        });
+        self.prune_dead_windows();
+        Ok(())
+    }
